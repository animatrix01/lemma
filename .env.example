# LEMMA — environment configuration (EXAMPLE — values empty)
# Copy this file to .env and fill in your real keys.
# NEVER commit .env — it is gitignored. Keys must never be
# printed to chat, logs, or exposed to the frontend.
# Frontend/Next.js receives NO keys: all LLM/search/NLI calls
# happen server-side in the FastAPI backend only.
# ============================================================

# --- LLM providers (both free tiers) ---
# Primary LLM: Groq llama-3.3-70b (extraction, mapping, judging, checklist)
GROQ_API_KEY=
# Fallback LLM (on Groq throttling/failure) + vision for image attachments
GEMINI_API_KEY=

# --- Web search (free tier: 1,000 credits/month) ---
# Source gathering, follow-up gap probes, F2 claim verification
TAVILY_API_KEY=

# --- Hugging Face free token (NLI is free with the token; no local models) ---
# NLI: cross-encoder/nli-deberta-v3-base (Inference API, SQLite-cached verdicts)
# Embeddings: all-MiniLM-L6-v2 (Inference API; degrade path = TF-IDF, no key needed)
HF_TOKEN=

# --- Backend constants (leave defaults for local dev) ---
# SQLite via SQLAlchemy
DATABASE_URL=sqlite:///./lemma.db
# Server config (loaded once via config.py / pydantic-settings)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Optional caps (aligned with TRD free-tier budgets)
TAVILY_MAX_INITIAL_SOURCES=6
TAVILY_MAX_GAP_PROBES=3
TAVILY_MAX_SCANNER_CLAIM_CHECKS=20
